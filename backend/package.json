{
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.3.0",
		"prettier": "^3.8.3",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vitest": "^4.1.5"
	},
	"name": "backend-starter",
	"version": "1.0.0",
	"description": "Reusable Fastify + TypeScript backend starter (routes → controllers → services, Swagger, Vitest)",
	"main": "server.js",
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^5.2.6",
		"csv-parse": "^6.2.1",
		"dotenv": "^17.4.2",
		"fastify": "^5.8.5",
		"fastify-http-errors-enhanced": "^7.0.1"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
		"dev": "tsx watch src/server.ts",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prettier": "prettier . --write 'src/**/*.ts'",
		"lint": "eslint 'src/**/*.ts'"
	},
	"keywords": [],
	"author": "Harry Carr",
	"license": "ISC",
	"type": "module"
}
